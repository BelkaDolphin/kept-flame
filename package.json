{
  "name": "kept-flame",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preflight": "node scripts/preflight.mjs",
    "check:llm-paths": "node scripts/check-llm-paths.mjs",
    "content:diff-gate": "node scripts/content-diff-gate.mjs",
    "bot:token": "node scripts/bot-token.mjs",
    "bot:pr": "node scripts/bot-pr.mjs",
    "measure:contrast": "node bench/tags-contrast.mjs",
    "golden:check": "node --experimental-strip-types --import ./tools/tsLoaderRegister.mjs tools/genGoldenVectors.ts --check",
    "golden:write": "node --experimental-strip-types --import ./tools/tsLoaderRegister.mjs tools/genGoldenVectors.ts --write",
    "sim:calibrate": "node --experimental-strip-types --import ./tools/tsLoaderRegister.mjs sim/calibrate.ts",
    "sim:recall-freq": "node --experimental-strip-types --import ./tools/tsLoaderRegister.mjs sim/recallFrequency.ts",
    "conformance:gen-harness-data": "node --experimental-strip-types --import ./tools/tsLoaderRegister.mjs tools/genHarnessData.ts",
    "conformance:build": "npm run conformance:gen-harness-data && vite build --config conformance/vite.harness.config.ts",
    "conformance:preview": "vite preview --config conformance/vite.harness.config.ts",
    "conformance:e2e": "playwright test",
    "bench:perf:build": "vite build --config bench/vite.perf.config.ts",
    "bench:perf:preview": "vite preview --config bench/vite.perf.config.ts",
    "bench:perf:e2e": "playwright test --config bench/playwright.perf.config.ts",
    "device:package": "npm run bench:perf:build && npm run conformance:build && node --experimental-strip-types --import ./tools/tsLoaderRegister.mjs tools/packageDevice.ts",
    "device:smoke": "playwright test --config bench/playwright.device.config.ts",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.1",
    "@emnapi/runtime": "^1.11.1",
    "@emnapi/wasi-threads": "^1.2.3",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.39.5",
    "jsep": "^1.4.0",
    "preact": "^10.29.7",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
